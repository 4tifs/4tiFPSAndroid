<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B0B">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:gravity="center"
        android:text="4tif"
        android:textColor="#FFFFFF"
        android:textSize="38sp"
        android:fontFamily="serif" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <Button android:id="@+id/patcherTab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="PATCHER" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <Button android:id="@+id/tiktokTab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="TIKTOK WEB" />
    </LinearLayout>

    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
